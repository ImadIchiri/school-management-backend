generator client {
  provider      = "prisma-client"
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  isDeleted   Boolean          @default(false)
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  permissions RolePermission[]
  users       User[]
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now())
  isDeleted   Boolean          @default(false)
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  roles       RolePermission[]
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  createdAt    DateTime   @default(now())
  isDeleted    Boolean    @default(false)
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])
}

model RefreshToken {
  id          String   @id @unique @default(uuid())
  hashedToken String   @unique
  userId      Int
  revoked     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  expireAt    DateTime
  User        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            Int            @id @default(autoincrement())
  nom           String
  prenom        String
  dateNaissance DateTime
  adresse       String
  telephone     String
  email         String         @unique
  password      String
  roleId        Int?
  createdAt     DateTime       @default(now())
  isDeleted     Boolean        @default(false)
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  candidat      Candidat?
  employe       Employe?
  etudiant      Etudiant?
  parent        Parent?
  refreshTokens RefreshToken[]
  Ressource     Ressource[]
  role          Role?          @relation(fields: [roleId], references: [id])
}

model Candidat {
  idCandidature      Int             @id @default(autoincrement())
  dateCandidature    DateTime
  etat               EtatCandidature @default(en_attente)
  userId             Int             @unique
  etudiantIdEtudiant Int?
  createdAt          DateTime        @default(now())
  isDeleted          Boolean         @default(false)
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  filiere            String
  niveau             NiveauCandidat
  etudiant           Etudiant?       @relation(fields: [etudiantIdEtudiant], references: [idEtudiant])
  user               User            @relation(fields: [userId], references: [id])
}

model Etudiant {
  idEtudiant      Int              @id @default(autoincrement())
  matricule       String           @unique
  dateInscription DateTime
  userId          Int              @unique
  filiereId       Int
  groupeId        Int
  createdAt       DateTime         @default(now())
  isDeleted       Boolean          @default(false)
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  absences        Absence[]
  Candidat        Candidat[]
  filiere         Filiere          @relation(fields: [filiereId], references: [id])
  groupe          Groupe           @relation(fields: [groupeId], references: [id])
  user            User             @relation(fields: [userId], references: [id])
  examens         EtudiantExamen[]
  events          Event[]          @relation("EtudiantToEvent")
  opportunites    Opportunite[]    @relation("EtudiantToOpportunite")
  parents         Parent[]         @relation("EtudiantToParent")
}

model Employe {
  idEmploye    Int           @id @default(autoincrement())
  poste        String
  salaire      Float
  userId       Int           @unique
  createdAt    DateTime      @default(now())
  isDeleted    Boolean       @default(false)
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  user         User          @relation(fields: [userId], references: [id])
  enseignant   Enseignant?
  events       Event[]
  opportunites Opportunite[]
}

model Enseignant {
  idEnseignant       Int                @id @default(autoincrement())
  specialite         String
  employeId          Int                @unique
  createdAt          DateTime           @default(now())
  isDeleted          Boolean            @default(false)
  updatedAt          DateTime           @updatedAt
  deletedAt          DateTime?
  Cours              Cours[]
  employe            Employe            @relation(fields: [employeId], references: [idEmploye])
  examens            Examen[]
  moduleAffectations ModuleEnseignant[]
  plannings          Planning[]
  groupes            Groupe[]           @relation("EnseignantToGroupe")
}

model Parent {
  idParent  Int        @id @default(autoincrement())
  userId    Int        @unique
  createdAt DateTime   @default(now())
  isDeleted Boolean    @default(false)
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  user      User       @relation(fields: [userId], references: [id])
  etudiants Etudiant[] @relation("EtudiantToParent")
}

model Filiere {
  id          Int              @id @default(autoincrement())
  nom         String           @unique
  description String
  createdAt   DateTime         @default(now())
  isDeleted   Boolean          @default(false)
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
  etudiants   Etudiant[]
  niveaux     NiveauScolaire[]
}

model NiveauScolaire {
  id         Int       @id @default(autoincrement())
  anneeLabel String
  dateDebut  DateTime
  dateFin    DateTime
  filiereId  Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  isDeleted  Boolean   @default(false)
  deletedAt  DateTime?
  groupes    Groupe[]
  modules    Module[]
  filiere    Filiere   @relation(fields: [filiereId], references: [id])
}

model Groupe {
  id          Int            @id @default(autoincrement())
  nom         String         @unique
  niveauId    Int
  createdAt   DateTime       @default(now())
  isDeleted   Boolean        @default(false)
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?
  etudiants   Etudiant[]
  niveau      NiveauScolaire @relation(fields: [niveauId], references: [id])
  enseignants Enseignant[]   @relation("EnseignantToGroupe")
}

model Module {
  id          Int                @id @default(autoincrement())
  nom         String
  description String
  niveauId    Int
  createdAt   DateTime           @default(now())
  isDeleted   Boolean            @default(false)
  updatedAt   DateTime           @updatedAt
  deletedAt   DateTime?
  cours       Cours[]
  examens     Examen[]
  niveau      NiveauScolaire     @relation(fields: [niveauId], references: [id])
  enseignants ModuleEnseignant[]
}

model Cours {
  id           Int              @id @default(autoincrement())
  titre        String
  description  String?
  dateDebut    DateTime
  dateFin      DateTime
  duree        Int?
  moduleId     Int
  enseignantId Int?
  salleId      Int?
  createdAt    DateTime         @default(now())
  isDeleted    Boolean          @default(false)
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  absences     Absence[]
  enseignant   Enseignant?      @relation(fields: [enseignantId], references: [idEnseignant])
  module       Module           @relation(fields: [moduleId], references: [id])
  salle        Salle?           @relation(fields: [salleId], references: [id])
  ressources   CoursRessource[]
  plannings    Planning[]
}

model TypeRessource {
  id         Int         @id @default(autoincrement())
  nom        String      @unique
  createdAt  DateTime    @default(now())
  isDeleted  Boolean     @default(false)
  updatedAt  DateTime    @updatedAt
  deletedAt  DateTime?
  ressources Ressource[]
}

model Ressource {
  id           Int              @id @default(autoincrement())
  titre        String
  description  String?
  url          String
  uploadedAt   DateTime         @default(now())
  uploadedById Int
  typeId       Int
  isDeleted    Boolean          @default(false)
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  coursLink    CoursRessource[]
  type         TypeRessource    @relation(fields: [typeId], references: [id])
  uploadedBy   User             @relation(fields: [uploadedById], references: [id])
}

model CoursRessource {
  id          Int       @id @default(autoincrement())
  coursId     Int
  ressourceId Int
  createdAt   DateTime  @default(now())
  isDeleted   Boolean   @default(false)
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  cours       Cours     @relation(fields: [coursId], references: [id])
  ressource   Ressource @relation(fields: [ressourceId], references: [id])
}

model Examen {
  id           Int              @id @default(autoincrement())
  titre        String
  type         String
  coeff        Float            @default(1)
  dateDebut    DateTime
  dateFin      DateTime
  dureeMinutes Int?
  moduleId     Int
  enseignantId Int
  salleId      Int?
  createdAt    DateTime         @default(now())
  isDeleted    Boolean          @default(false)
  updatedAt    DateTime         @updatedAt
  deletedAt    DateTime?
  etudiants    EtudiantExamen[]
  enseignant   Enseignant       @relation(fields: [enseignantId], references: [idEnseignant])
  module       Module           @relation(fields: [moduleId], references: [id])
  salle        Salle?           @relation(fields: [salleId], references: [id])
}

model Absence {
  id         Int            @id @default(autoincrement())
  date       DateTime
  motif      String?
  statut     StatutPresence @default(PRESENT)
  etudiantId Int
  coursId    Int
  createdAt  DateTime       @default(now())
  isDeleted  Boolean        @default(false)
  updatedAt  DateTime       @updatedAt
  deletedAt  DateTime?
  cours      Cours          @relation(fields: [coursId], references: [id])
  etudiant   Etudiant       @relation(fields: [etudiantId], references: [idEtudiant])
}

model Salle {
  id        Int        @id @default(autoincrement())
  nom       String     @unique
  capacite  Int
  createdAt DateTime   @default(now())
  isDeleted Boolean    @default(false)
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  Cours     Cours[]
  Examen    Examen[]
  plannings Planning[]
}

model Planning {
  id           Int        @id @default(autoincrement())
  dateDebut    DateTime
  dateFin      DateTime
  description  String
  coursId      Int
  enseignantId Int
  salleId      Int
  createdAt    DateTime   @default(now())
  isDeleted    Boolean    @default(false)
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?
  cours        Cours      @relation(fields: [coursId], references: [id])
  enseignant   Enseignant @relation(fields: [enseignantId], references: [idEnseignant])
  salle        Salle      @relation(fields: [salleId], references: [id])
}

model Event {
  id        Int        @id @default(autoincrement())
  titre     String
  date      DateTime
  employeId Int
  createdAt DateTime   @default(now())
  isDeleted Boolean    @default(false)
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  employe   Employe    @relation(fields: [employeId], references: [idEmploye])
  etudiants Etudiant[] @relation("EtudiantToEvent")
}

model Opportunite {
  id        Int        @id @default(autoincrement())
  titre     String
  type      String
  employeId Int
  createdAt DateTime   @default(now())
  isDeleted Boolean    @default(false)
  updatedAt DateTime   @updatedAt
  deletedAt DateTime?
  employe   Employe    @relation(fields: [employeId], references: [idEmploye])
  etudiants Etudiant[] @relation("EtudiantToOpportunite")
}

model ModuleEnseignant {
  id              Int        @id @default(autoincrement())
  dateAffectation DateTime
  enseignantId    Int
  moduleId        Int
  createdAt       DateTime   @default(now())
  isDeleted       Boolean    @default(false)
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?
  enseignant      Enseignant @relation(fields: [enseignantId], references: [idEnseignant])
  module          Module     @relation(fields: [moduleId], references: [id])
}

model EtudiantExamen {
  id             Int       @id @default(autoincrement())
  present        Boolean
  note           Float
  mention        String
  dateEvaluation DateTime
  etudiantId     Int
  examenId       Int
  createdAt      DateTime  @default(now())
  isDeleted      Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
  etudiant       Etudiant  @relation(fields: [etudiantId], references: [idEtudiant])
  examen         Examen    @relation(fields: [examenId], references: [id])
}

enum EtatCandidature {
  en_attente
  en_cours
  accepte
  refuse
  incomplet
}

enum StatutPresence {
  PRESENT
  ABSENT
  RETARD
  JUSTIFIE
}

enum NiveauCandidat {
  BACHELOR_1
  BACHELOR_2
  BACHELOR_3
  MASTER_1
  MASTER_2
  MASTER_3
}
